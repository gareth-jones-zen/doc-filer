<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, nullable, warnings-as-errors and the AOT analysers come from Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>doc-filer</AssemblyName>
    <RootNamespace>DocFiler</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- The shipped Lua filters travel with the executable, so a config can name one by file name. -->
  <ItemGroup>
    <None Include="..\filters\*.lua" Link="filters\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\styles\*.css" Link="styles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The pdf command's image-width option shrinks images with GDI+. The tool is Windows-only already (Task Scheduler, Edge). -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
